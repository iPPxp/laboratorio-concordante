{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moc:extractor:001-c:1.0.0",
  "title": "MOC-EXTRACTOR-001-C batch output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "extractor_id", "cases"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "extractor_id": {"type": "string", "const": "MOC-EXTRACTOR-001-C"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/case_output"}
    }
  },
  "$defs": {
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "field", "surface_value", "normalized_value", "provenance", "normalization_rule", "evidence_span"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^DEV[0-9]{3}-C[0-9]{2}$"},
        "field": {
          "type": "string",
          "enum": [
            "accion_candidata",
            "accion_rechazada",
            "accion_reportada",
            "clima_emocional",
            "condicion_futura",
            "estado_factual",
            "estado_temporal",
            "evaluacion_situacional",
            "horizonte_temporal",
            "intencion_declarada",
            "obligacion_declarada",
            "recurso_mencionado",
            "valor_declarado"
          ]
        },
        "surface_value": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "const": "reported"},
        "normalization_rule": {"type": "string", "pattern": "^NORM-[A-Z0-9-]+$"},
        "evidence_span": {"$ref": "#/$defs/evidence_span"}
      }
    },
    "constraint_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "field", "surface_value", "normalized_value", "provenance", "normalization_rule", "operational_effect", "requires_verification", "evidence_span"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^DEV[0-9]{3}-R[0-9]{2}$"},
        "field": {"type": "string", "enum": ["restriccion_externa", "restriccion_financiera", "restriccion_tecnica"]},
        "surface_value": {"type": "string", "minLength": 1},
        "normalized_value": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "const": "reported_constraint"},
        "normalization_rule": {"type": "string", "pattern": "^NORM-CONST-[A-Z0-9-]+$"},
        "operational_effect": {"type": "string", "const": "unknown"},
        "requires_verification": {"type": "boolean", "const": true},
        "evidence_span": {"$ref": "#/$defs/evidence_span"}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "field", "type", "evidence_span"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^DEV[0-9]{3}-U[0-9]{2}$"},
        "field": {"type": "string", "minLength": 1},
        "type": {"type": "string", "const": "explicit_unknown"},
        "evidence_span": {"$ref": "#/$defs/evidence_span"}
      }
    },
    "friction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "claim_refs", "annotation_rule", "description"],
      "properties": {
        "type": {"type": "string", "enum": ["ambiguity", "contradiction", "tension"]},
        "claim_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^DEV[0-9]{3}-[CRU][0-9]{2}$"}
        },
        "annotation_rule": {"type": "string", "pattern": "^FRICTION-[A-Z0-9-]+$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "case_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "claims", "constraint_candidates", "unknowns", "frictions"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^EXP-A-DEV-[0-9]{3}$"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "constraint_candidates": {"type": "array", "items": {"$ref": "#/$defs/constraint_candidate"}},
        "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
        "frictions": {"type": "array", "items": {"$ref": "#/$defs/friction"}}
      }
    }
  }
}
